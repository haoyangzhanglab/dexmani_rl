# Source: ../dexmani_policy/.codex/config.toml
# This example is NOT loaded automatically.
# Install as .codex/config.toml from a terminal allowed to write that directory,
# then start a new trusted project session. Preserve any existing config first.
# Managed policies and session restrictions still take precedence.
# Reference: https://learn.chatgpt.com/docs/config-file/config-reference

model_verbosity = "low"
approval_policy = "on-request"
approvals_reviewer = "auto_review"
sandbox_mode = "workspace-write"
web_search = "live"

[sandbox_workspace_write]
network_access = false

[agents]
max_concurrent_threads_per_session = 2
